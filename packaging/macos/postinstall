#!/bin/bash
# PKG post-install script — runs as root after files are copied.
# Creates required directories, sets permissions, and loads the daemon.
set -euo pipefail

DAEMON_LABEL="com.firstaid.doctor.daemon"
PLIST="/Library/LaunchDaemons/${DAEMON_LABEL}.plist"
BIN="/usr/local/bin/firstaid"
DATA_DIR="/var/lib/firstaid"
LOG_DIR="/var/log/firstaid"

# ── Directories ──────────────────────────────────────────────────────────────

mkdir -p "$DATA_DIR" "$LOG_DIR"

# Owned by root, group wheel, not world-readable (DB contains diagnostics)
chown root:wheel "$DATA_DIR"
chmod 750 "$DATA_DIR"

chown root:wheel "$LOG_DIR"
chmod 755 "$LOG_DIR"

# ── Binary permissions ────────────────────────────────────────────────────────

chown root:wheel "$BIN"
chmod 755 "$BIN"

# ── Load daemon ───────────────────────────────────────────────────────────────

if [ -f "$PLIST" ]; then
    chown root:wheel "$PLIST"
    chmod 644 "$PLIST"
    launchctl load -w "$PLIST"
    echo "FirstAid Doctor daemon loaded — use 'launchctl list | grep firstaid' to verify."
fi

echo "FirstAid Doctor installed successfully."
echo "Run 'firstaid diagnose' to test, or check /var/log/firstaid/firstaid.log for daemon output."

exit 0
